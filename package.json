{
  "name": "nuxt-easy-lightbox",
  "version": "1.2.0",
  "description": "A plugin to the simple Vue 3 Image Lightbox component with Zoom / Drag / Rotate / Switch.",
  "repository": "modbender/nuxt-easy-lightbox",
  "keywords": [
    "vue",
    "vue.js",
    "vue3",
    "vue 3",
    "nuxt",
    "nuxt3",
    "nuxt 3",
    "nuxt4",
    "nuxt 4",
    "lightbox",
    "easy",
    "carousel",
    "slideshow",
    "gallery",
    "lightweight",
    "touch",
    "responsive",
    "image"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "vue-easy-lightbox": "^1.19.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.10.7",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.3",
    "nuxt": "^4.4.8",
    "playwright-core": "^1.61.0",
    "prettier": "^3.8.4",
    "typescript": "~5.8.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
